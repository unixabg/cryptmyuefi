#!/bin/bash
set -e


# Attempt to rsync files from build to mounted device
echo_debug "Attempting to rsync ${_BUILDDIR}/root/ to /mnt/cryptmyuefi/ ..."
rsync -HPavz -q "${_BUILDDIR}"/root/ /mnt/cryptmyuefi/
echo


# Sync file system
echo_debug "Syncing the filesystems ...."
sync
sync
echo_debug "- Done syncing the filesystems."
echo
